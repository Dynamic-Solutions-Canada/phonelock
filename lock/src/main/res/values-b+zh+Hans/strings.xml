<?xml version="1.0" encoding="utf-8"?>
<!-- Wording shared across the lock app (the child's phone). Each screen or feature keeps its own wording in
     its own strings_<area>.xml beside this file; every file here needs the same file, with the same names,
     in each values-<language> folder. Two audiences read it: the child (home, ring and emergency screens)
     and parents (parent mode, connections, diagnostics, and events sent to the parent app); comments say
     which when it matters. Names, app labels and anything typed by a person are never translated. -->
<!-- Simplified Chinese. The child is addressed as 你 in short, simple words; parent-facing text matches the
     parent app's Chinese (its glossary is in companion values-b+zh+Hans/strings.xml): device = 设备;
     parent mode = 家长模式; limited hours = 限时时段; bedtime = 就寝时间; "Ask for an app" = “申请应用”. -->
<resources>
    <!-- The app's name as Android shows it (it is the child's home screen) -->
    <string name="app_name">主屏幕</string>

    <!-- Common buttons: use these rather than adding another copy -->
    <string name="cancel">取消</string>
    <string name="ok">确定</string>
    <string name="done">完成</string>
    <string name="close">关闭</string>

    <string name="screen_service_label">家长查看屏幕</string>
    <!-- Accessibility service description, shown to whoever opens Settings > Accessibility (parent) -->
    <string name="screen_service_description">家长请求时，可让家长查看这个屏幕，并关闭可能绕过锁定的 Google 界面。陌生的 Google 界面会以图片形式发送给你的家长。每次你都会收到提示。</string>
</resources>
