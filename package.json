{
  "name": "phonelock",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": "24.22.3",
    "npm": "11.19.1"
  },
  "scripts": {
    "verify:android": "scripts/dev/gradle :lock:assembleDebug :companion:assembleGithubDebug :companion:assemblePlayDebug",
    "build:android": "scripts/dev/gradle :lock:assembleDebug :companion:assembleGithubDebug",
    "package:android": "scripts/dev/gradle :lock:assembleRelease :companion:assembleGithubRelease :companion:bundlePlayRelease",
    "install:android": "adb install -r android/companion/build/outputs/apk/github/debug/companion-github-debug.apk",
    "format": "scripts/dev/gradle spotlessApply",
    "format:check": "scripts/dev/gradle spotlessCheck",
    "lint": "scripts/dev/gradle :lock:lintDebug :companion:lintGithubDebug :companion:lintPlayDebug",
    "test": "npm run test:android && npm run test:scripts",
    "test:android": "scripts/dev/gradle :lock:testDebugUnitTest :companion:testGithubDebugUnitTest :companion:testPlayDebugUnitTest",
    "test:scripts": "node --test 'scripts/*/*.test.mjs'",
    "test:device": "scripts/dev/gradle :companion:connectedGithubDebugAndroidTest",
    "check:l10n": "python3 scripts/dev/check-l10n.py",
    "check:prefs": "python3 scripts/dev/check-prefs.py",
    "check:listings": "node scripts/dev/check-listings.mjs",
    "check:release-notes": "node scripts/deploy/release-notes.mjs check",
    "validate": "npm run format:check && npm run lint && npm run test && npm run check:l10n && npm run check:prefs && npm run check:listings && npm run check:icons && npm run check:release-notes && npm run verify:android",
    "icons": "devkit-icons",
    "check:icons": "devkit-icons --check"
  },
  "//": [
    "devDependencies are build tools only, never shipped. @dynamic-solutions-canada/devkit and @resvg/resvg-js: the shared icon generator, devkit-icons, and the renderer it asks repos to install (approved: standards session for Ryan, ASSET-3 (2026-11-19))."
  ],
  "devDependencies": {
    "@dynamic-solutions-canada/devkit": "github:Dynamic-Solutions-Canada/devkit#v0.25.0",
    "@resvg/resvg-js": "2.6.2"
  }
}
