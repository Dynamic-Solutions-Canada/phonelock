    <!-- First-run disclosure, which the parent must accept before adding a device -->
    <string name="device_disclosure_title">Avant de commencer</string>
    <string name="device_disclosure_intro">PhoneLock est une application de contrôle parental. Elle vous permet de gérer le téléphone ou la tablette de votre enfant et d’en consulter certaines informations.</string>
    <string name="device_disclosure_seen_title">Ce que vous verrez de l’appareil de votre enfant</string>
    <!-- A bulleted list: keep one item per line -->
    <string name="device_disclosure_seen">• Sa position : sur demande, et un relevé toutes les 15 minutes (toutes les 2 minutes en déplacement), conservé 7 jours\n• Le niveau de batterie, et quand l’appareil s’éteint ou s’allume\n• Les applications installées, les demandes pour les utiliser, et quelles applications sont utilisées et combien de temps\n• Les réseaux Wi-Fi rejoints et les appareils Bluetooth associés\n• Les appels (journal d’appels) et les contacts\n• Les fichiers, photos et vidéos de son espace de stockage partagé, quand vous les ouvrez\n• Son écran, quand vous appuyez sur Voir l’écran</string>
    <string name="device_disclosure_readers_title">Qui peut les consulter</string>
    <string name="device_disclosure_readers">Seulement vous et les autres parents avec qui vous partagez l’appareil. Tout est chiffré de bout en bout sur les appareils ; le serveur relais qui transmet les messages, ainsi que le service de notifications push de Google, ne voient jamais que des données chiffrées. Rien n’est vendu ni utilisé à des fins publicitaires.</string>
    <string name="device_disclosure_child_title">Votre enfant est informé</string>
    <string name="device_disclosure_child">Son écran d’accueil indique que la position, la batterie, les appels et l’utilisation des applications vous sont communiqués ; votre enfant reçoit un avis chaque fois qu’un parent consulte son écran, et une notification indique que le contrôle parental est actif. PhoneLock ne peut pas lui être caché.</string>
    <string name="device_disclosure_consent">En continuant, vous confirmez être le parent ou le tuteur légal de l’enfant dont vous gérerez l’appareil, ou avoir sa permission, et n’utiliser PhoneLock qu’à cette fin.</string>
    <!-- Opens the privacy policy, which is in English -->
    <string name="device_privacy_policy">Politique de confidentialité (en anglais)</string>
    <string name="device_disclosure_agree">J’accepte, continuer</string>

