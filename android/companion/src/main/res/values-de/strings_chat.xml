<?xml version="1.0" encoding="utf-8"?>
<!-- The family chat: the Chat row on a child's page, the chat page, the parents' limits on the child's sending, and chat notifications. -->
<resources>
    <!-- Title of the chat page and of its row on a child's device page -->
    <string name="chat_title">Chat</string>
    <!-- Notification channel for new chat messages -->
    <string name="chat_channel">Familienchat</string>
    <string name="chat_empty">Noch keine Nachrichten.</string>
    <string name="chat_you">Du</string>
    <!-- A message with its sender. %1$s: who wrote it (a name, or "You"); %2$s: the message -->
    <string name="chat_notification_line">%1$s: %2$s</string>
    <!-- Under this parent's own message: not stored by the child's phone yet -->
    <string name="chat_sending">Wird gesendet</string>
    <!-- Under this parent's own message: the child's phone has it -->
    <string name="chat_delivered">Zugestellt</string>
    <!-- Under this parent's own message: the child has opened the chat since -->
    <string name="chat_seen">Gesehen</string>
    <!-- Placeholder of the field where a parent writes a message -->
    <string name="chat_message_hint">Nachricht</string>
    <string name="chat_send">Senden</string>
    <!-- Chip: the child can send only one message every few minutes -->
    <string name="chat_slow_mode">Langsamer Modus</string>
    <!-- Chip while slow mode is on. %1$s: a length of time, such as "5 min" -->
    <string name="chat_slow_mode_on">Langsamer Modus: %1$s</string>
    <string name="chat_slow_mode_off">Aus</string>
    <!-- Choice in the slow mode dialog. %1$s: a length of time, such as "5 min" -->
    <string name="chat_slow_mode_every">Eine Nachricht alle %1$s</string>
    <!-- %1$s: the child's name or device name -->
    <string name="chat_slow_mode_title">Wie oft darf %1$s Nachrichten senden?</string>
    <string name="chat_slow_mode_note">Nur die Nachrichten deines Kindes werden begrenzt. Eltern können immer schreiben, und alle können immer lesen.</string>
    <!-- Chip: the child can't send messages for a while -->
    <string name="chat_timeout">Pause</string>
    <!-- Chip while a timeout runs. %1$s: a time, such as 6:00 p.m. -->
    <string name="chat_timeout_until">Pause bis %1$s</string>
    <!-- %1$s: the child's name or device name -->
    <string name="chat_timeout_title">Wie lange keine Nachrichten von %1$s?</string>
    <string name="chat_timeout_note">Dein Kind kann den Chat und deine Nachrichten weiterhin lesen.</string>
    <string name="chat_timeout_end">Pause jetzt beenden</string>
    <!-- On the Chat row. %1$d: how many messages from the child or other parents haven't been shown here -->
    <plurals name="chat_unread">
        <item quantity="one">%1$d ungelesene Nachricht</item>
        <item quantity="other">%1$d ungelesene Nachrichten</item>
    </plurals>
</resources>
