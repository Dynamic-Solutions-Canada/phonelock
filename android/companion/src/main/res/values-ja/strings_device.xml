    <!-- %1$d: the version, %2$d: percent downloaded -->
    <string name="device_app_downloading">バージョン 1.0.%1$d をダウンロード中：%2$d%%</string>
    <string name="device_app_installing">バージョン 1.0.%1$d をインストール中…</string>
    <string name="device_app_update_to">バージョン 1.0.%1$d にアップデート</string>
