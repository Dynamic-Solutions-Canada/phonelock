    <!-- Settings > Lock app: the language PhoneLock uses on the child's device -->
    <string name="device_language_title">お子様のデバイスの言語</string>
    <string name="device_language_match">お子様のデバイスの設定に合わせる</string>
    <string name="device_language_note">お子様のデバイスの PhoneLock と、ここに届くアクティビティはこの言語になります。そのデバイスの他のアプリは、デバイス自体の言語に従います。</string>
