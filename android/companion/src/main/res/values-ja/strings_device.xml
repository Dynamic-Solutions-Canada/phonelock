    <string name="device_app_update_detail">%1$d MB のダウンロード。インストール時に Android から確認を求められます。</string>
    <string name="device_app_check_detail">GitHub の PhoneLock リリースから</string>
    <string name="device_app_none_published">このアプリのアップデートはまだ公開されていません</string>
    <string name="device_app_up_to_date">このアプリは最新です（バージョン 1.0.%1$d）</string>
