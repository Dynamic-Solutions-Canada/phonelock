<?xml version="1.0" encoding="utf-8"?>
<!-- The family chat: the Chat row on a child's page, the chat page, the parents' limits on the child's sending, and chat notifications. -->
<resources>
    <!-- Title of the chat page and of its row on a child's device page -->
    <string name="chat_title">Chat</string>
    <!-- Notification channel for new chat messages -->
    <string name="chat_channel">Chat da família</string>
    <string name="chat_empty">Nenhuma mensagem ainda.</string>
    <string name="chat_you">Você</string>
    <!-- A message with its sender. %1$s: who wrote it (a name, or "You"); %2$s: the message -->
    <string name="chat_notification_line">%1$s: %2$s</string>
    <!-- Under this parent's own message: not stored by the child's phone yet -->
    <string name="chat_sending">Enviando</string>
    <!-- Under this parent's own message: the child's phone has it -->
    <string name="chat_delivered">Entregue</string>
    <!-- Under this parent's own message: the child has opened the chat since -->
    <string name="chat_seen">Vista</string>
    <!-- Placeholder of the field where a parent writes a message -->
    <string name="chat_message_hint">Mensagem</string>
    <string name="chat_send">Enviar</string>
    <!-- Chip: the child can send only one message every few minutes -->
    <string name="chat_slow_mode">Modo lento</string>
    <!-- Chip while slow mode is on. %1$s: a length of time, such as "5 min" -->
    <string name="chat_slow_mode_on">Modo lento: %1$s</string>
    <string name="chat_slow_mode_off">Desativado</string>
    <!-- Choice in the slow mode dialog. %1$s: a length of time, such as "5 min" -->
    <string name="chat_slow_mode_every">Uma mensagem a cada %1$s</string>
    <!-- %1$s: the child's name or device name -->
    <string name="chat_slow_mode_title">Com que frequência %1$s pode enviar mensagens?</string>
    <string name="chat_slow_mode_note">Só as mensagens do seu filho são limitadas. Os pais sempre podem escrever, e todos sempre podem ler.</string>
    <!-- Chip: the child can't send messages for a while -->
    <string name="chat_timeout">Pausa</string>
    <!-- Chip while a timeout runs. %1$s: a time, such as 6:00 p.m. -->
    <string name="chat_timeout_until">Pausa até %1$s</string>
    <!-- %1$s: the child's name or device name -->
    <string name="chat_timeout_title">Por quanto tempo sem mensagens de %1$s?</string>
    <string name="chat_timeout_note">Seu filho ainda pode ler o chat e as suas mensagens.</string>
    <string name="chat_timeout_end">Encerrar a pausa agora</string>
    <!-- On the Chat row. %1$d: how many messages from the child or other parents haven't been shown here -->
    <plurals name="chat_unread">
        <item quantity="one">%1$d mensagem não lida</item>
        <item quantity="many">%1$d mensagens não lidas</item>
        <item quantity="other">%1$d mensagens não lidas</item>
    </plurals>
</resources>
