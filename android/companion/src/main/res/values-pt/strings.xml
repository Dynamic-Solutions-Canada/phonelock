<?xml version="1.0" encoding="utf-8"?>
<!-- Wording shared across the app. Each screen or feature keeps its own wording in its own
     strings_<area>.xml beside this file; every file here needs the same file, with the same names, in each
     values-<language> folder. Names, app labels and anything typed by a person are never translated. -->
<!-- Portuguese, written in Brazilian Portuguese. Glossary: device = dispositivo; parent (person) = responsável;
     parent mode = modo dos pais; parent PIN = PIN dos pais; limited hours = horário limitado; bedtime = hora de dormir;
     normal hours = horário normal; allow = permitir; request = pedido; "Ask for an app" (child's button) = "Pedir um app". -->
<resources>
    <string name="app_name">PhoneLock</string>

    <!-- Common buttons and labels: use these rather than adding another copy -->
    <string name="cancel">Cancelar</string>
    <string name="save">Salvar</string>
    <string name="done">Concluído</string>
    <string name="open">Abrir</string>
    <string name="remove">Remover</string>
    <string name="delete">Excluir</string>
    <string name="refresh">Atualizar</string>
    <string name="try_again">Tentar novamente</string>
    <string name="back">Voltar</string>
    <string name="next">Próximo</string>
    <string name="add">Adicionar</string>
    <string name="allow">Permitir</string>
    <string name="deny">Negar</string>
    <string name="undo">Desfazer</string>
    <string name="your_name">Seu nome</string>
    <string name="child_device_name">Nome do dispositivo da criança</string>

    <!-- Lengths of time, as fmtMinutes() writes them -->
    <string name="duration_minutes">%1$d min</string>
    <string name="duration_hours">%1$d h</string>
    <string name="duration_hours_minutes">%1$d h %2$d min</string>
    <!-- Under a length field or as a message. %1$s is the longest length allowed, such as "4 h". -->
    <string name="length_at_most">No máximo %1$s.</string>

    <!-- Settings > Language -->
    <string name="language_title">Idioma</string>
    <string name="language_match_device">Seguir o dispositivo</string>
    <string name="language_detail">O idioma que este app usa neste celular</string>
</resources>
