    <!-- Setting up over Wi-Fi. Names of Android's own settings screens and options on the child's device
         (Settings, About phone, Build number, System, Developer options, Wireless debugging, "Pair device with
         pairing code", "IP address & Port", Passwords & accounts, Multiple users) must match the names Android
         itself uses in this language. -->
    <string name="setup_what_this_does">作用说明</string>
    <!-- %1$s is the child's device name -->
    <string name="setup_fix_explanation">“修复设置”会为 %1$s 重新开启 PhoneLock 的各项功能：查看屏幕、通话限制和通话记录、文件、在勿扰模式下响铃，以及待机时保持运行。它不会更改设备的配对、时间表或应用。</string>
    <string name="setup_need_same_wifi_fix">孩子的设备与这部手机连接同一个 Wi-Fi</string>
