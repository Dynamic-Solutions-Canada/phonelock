    <string name="device_diag_no_report">还没有报告。</string>
    <!-- %1$s: when the report was made -->
    <string name="device_diag_report_from">%1$s 的报告</string>
    <string name="device_diag_checks">检查项</string>
    <string name="device_diag_recent_log">最近日志</string>
