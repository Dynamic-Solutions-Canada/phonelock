<?xml version="1.0" encoding="utf-8"?>
<!-- Events the lock app reports to the parents' app, and the notices it posts on the child's phone about them. -->
<resources>

    <!-- ========== Shared ========== -->

    <!-- Audience: child and parent. Stands in for a parent's name when a command came without one; used as
         the parent's name in the strings below. -->
    <string name="events_a_parent">A parent</string>

    <!-- Audience: child and parent. Wi-Fi and Bluetooth appear on the home screen and in the parents' app list
         as if they were apps; these are their names. They open the screens where she can change Wi-Fi or
         Bluetooth settings. -->
    <string name="events_wifi_settings">Wi-Fi settings</string>
    <string name="events_bluetooth_settings">Bluetooth settings</string>

    <!-- Audience: child (home screen) and parent. The current schedule mode's name. -->
    <string name="events_mode_label_normal">Normal</string>
    <string name="events_mode_label_limited">Limited hours</string>
    <string name="events_mode_label_bedtime">Bedtime</string>

    <!-- ========== Notifications on the child's phone ========== -->

    <!-- Audience: child. Notification channel names, shown in Android's notification settings. -->
    <string name="events_channel_from_parents">From parents</string>
    <string name="events_channel_parent_controls">Parent controls</string>
    <!-- Audience: child. The permanent notification while the lock is running. -->
    <string name="events_parent_controls_active">Parent controls active</string>

    <!-- Audience: child. A parent changed something. In each, the last placeholder in brackets is the parent's
         name; %1$s is an app's name where there is one; times are already formatted (e.g. 6:00 PM). -->
    <string name="events_allowed_until_child">%1$s allowed until %2$s (%3$s)</string>
    <string name="events_turned_off_child">%1$s turned off</string>
    <string name="events_all_turned_off_child">All extra apps turned off</string>
    <string name="events_paused_until_child">%1$s paused until %2$s (%3$s)</string>
    <string name="events_back_child">%1$s is back (%2$s)</string>
    <!-- %1$s: the app she asked for; %2$s: parent's name -->
    <string name="events_declined_child">Request for %1$s was declined (%2$s)</string>
    <!-- %1$s: parent's name -->
    <string name="events_declined_any_child">Request for an app was declined (%1$s)</string>
    <!-- %1$s: time; %2$s: parent's name -->
    <string name="events_limited_started_child">Limited hours started until %1$s (%2$s)</string>
    <string name="events_bedtime_started_child">Bedtime started until %1$s (%2$s)</string>
    <!-- %1$s: parent's name -->
    <string name="events_manual_mode_ended_child">Manual limited hours or bedtime ended (%1$s)</string>
    <string name="events_parent_mode_ended_child">Parent mode ended (%1$s)</string>
    <!-- %1$s: time; %2$s: parent's name -->
    <string name="events_parent_mode_on_child">Parent mode on until %1$s (%2$s)</string>
    <!-- %1$s: parent's name; %2$s: contact's name -->
    <string name="events_contact_added_child">%1$s added %2$s to your contacts</string>
    <string name="events_contact_removed_child">%1$s removed %2$s from your contacts</string>
    <!-- %1$s: parent's name; %2$s: app name -->
    <string name="events_uninstalled_child">%1$s uninstalled %2$s</string>
    <!-- %1$s: parent's name -->
    <string name="events_screen_viewed_child">%1$s viewed your screen</string>

    <!-- Audience: child. A Google services screen she opened was sent to her parents as a picture. -->
    <string name="events_screen_picture_sent">A picture of this screen was sent to your parents</string>

    <!-- Audience: child. %1$s: the contact's name or the phone number she tried to call. -->
    <string name="events_call_not_allowed_child">Calling %1$s isn\'t allowed. Ask a parent to add it to your safe list.</string>

    <!-- Audience: child. A daily app time limit is nearly used up. %1$d: minutes left; %2$s: the limit's name
         (an app name, or a group name a parent chose). -->
    <plurals name="events_minutes_left_today">
        <item quantity="one">%1$d minute left today for %2$s</item>
        <item quantity="other">%1$d minutes left today for %2$s</item>
    </plurals>
    <!-- Audience: child. %1$s: the limits that ran out, as a list of names. -->
    <string name="events_times_up_today_child">Time\'s up for today: %1$s. Ask a parent if you need more time.</string>

    <!-- ========== Shown to both ========== -->

    <!-- Audience: child and parent. Apps a parent allowed for a while have run out. %1$s: list of app names. -->
    <string name="events_times_up">Time\'s up: %1$s</string>
    <!-- Audience: child and parent. Apps a parent paused for a while are allowed again. %1$s: list of app
         names; the count is how many apps. -->
    <plurals name="events_apps_back">
        <item quantity="one">%1$s is back</item>
        <item quantity="other">%1$s are back</item>
    </plurals>

    <!-- ========== Events sent to the parents' app ========== -->

    <!-- Audience: parent. What a parent did, shown in the other parent's activity list. %1$s is always the
         parent's name; %2$s an app's name; times are already formatted (e.g. 6:00 PM). -->
    <string name="events_allowed_until">%1$s: %2$s allowed until %3$s</string>
    <string name="events_turned_off">%1$s: %2$s turned off</string>
    <string name="events_all_turned_off">%1$s: All extra apps turned off</string>
    <string name="events_paused_until">%1$s: %2$s paused until %3$s</string>
    <string name="events_back">%1$s: %2$s is back</string>
    <!-- %2$s: the app the child asked for -->
    <string name="events_declined">%1$s: Request for %2$s was declined</string>
    <string name="events_declined_any">%1$s: Request for an app was declined</string>
    <string name="events_home_added">%1$s: %2$s added to the home screen</string>
    <string name="events_home_removed">%1$s: %2$s removed from the home screen</string>
    <!-- When an app may be used: in normal hours, limited hours and bedtime (the schedule's three modes), or
         only when a parent allows it for a while. -->
    <string name="events_appmode_none">%1$s: %2$s blocked except when allowed for a while</string>
    <string name="events_appmode_all">%1$s: %2$s always allowed</string>
    <string name="events_appmode_normal">%1$s: %2$s allowed in normal hours</string>
    <string name="events_appmode_limited">%1$s: %2$s allowed in limited hours</string>
    <string name="events_appmode_bedtime">%1$s: %2$s allowed in bedtime</string>
    <string name="events_appmode_normal_limited">%1$s: %2$s allowed in normal and limited hours</string>
    <string name="events_appmode_normal_bedtime">%1$s: %2$s allowed in normal hours and bedtime</string>
    <string name="events_appmode_limited_bedtime">%1$s: %2$s allowed in limited hours and bedtime</string>
    <string name="events_schedule_changed">%1$s changed the schedule</string>
    <!-- %2$s: time -->
    <string name="events_limited_started">%1$s: Limited hours started until %2$s</string>
    <string name="events_bedtime_started">%1$s: Bedtime started until %2$s</string>
    <string name="events_manual_mode_ended">%1$s: Manual limited hours or bedtime ended</string>
    <string name="events_limits_changed">%1$s changed the app time limits</string>
    <!-- The list of apps a parent can give access to (and the child can ask for) -->
    <string name="events_offer_on">%1$s: %2$s put back on the app list</string>
    <string name="events_offer_off">%1$s: %2$s taken off the app list</string>
    <string name="events_calls_changed">%1$s changed the call settings</string>
    <string name="events_parent_mode_ended">%1$s: Parent mode ended</string>
    <!-- %2$s: time -->
    <string name="events_parent_mode_on">%1$s: Parent mode on until %2$s</string>
    <string name="events_pin_changed">%1$s changed the parent PIN</string>
    <string name="events_battery_alerts_off">%1$s turned off low-battery alerts</string>
    <!-- %2$d: battery percentage -->
    <string name="events_battery_alert_set">%1$s set the low-battery alert to %2$d%%</string>
    <string name="events_debugging_off">%1$s turned debugging off</string>
    <!-- %2$s: contact's name -->
    <string name="events_contact_added">%1$s: added contact %2$s</string>
    <string name="events_contact_removed">%1$s: removed contact %2$s</string>
    <!-- %1$s: contact's name -->
    <string name="events_contact_add_failed">Couldn\'t add contact %1$s</string>
    <string name="events_ringing">%1$s is ringing the device</string>
    <string name="events_ringing_stopped">%1$s stopped the ringing</string>
    <string name="events_screen_viewed">%1$s viewed the screen</string>
    <!-- %2$s: app name -->
    <string name="events_uninstalled">%1$s: uninstalled %2$s</string>

    <!-- Audience: parent. A parent's command couldn't be carried out. %1$s: app name. -->
    <string name="events_not_installed">%1$s is not installed</string>
    <string name="events_allowed_while_offline">%1$s was allowed while the device was offline; that time has passed</string>
    <string name="events_cant_uninstall">%1$s can\'t be uninstalled</string>
    <string name="events_uninstall_failed">Couldn\'t uninstall %1$s</string>
    <string name="events_uninstall_needs_device">Couldn\'t uninstall %1$s without asking on the device</string>

    <!-- Audience: parent. Google services screens that lead out of the lock, which parents can allow or block
         as a group. Each names what the screens are for. -->
    <string name="events_area_account">Manage your Google Account</string>
    <string name="events_area_settings">Google settings</string>
    <string name="events_area_help">Google help pages</string>
    <string name="events_area_feedback">Send feedback to Google</string>
    <string name="events_area_quickshare">Quick Share (files from nearby phones)</string>
    <!-- Audience: parent. Names one Google services screen, used as %2$s in the screen decisions below.
         %1$s: a technical screen name such as "accountsettings › AccountDetails" (not translated). -->
    <string name="events_screen_named">the Google services screen %1$s</string>
    <!-- Audience: parent. A parent's decision about a Google services screen or group of screens. %1$s:
         parent's name; %2$s: the group's name (above) or "the Google services screen …"; %3$s: time. -->
    <string name="events_screen_rule_allowed">%1$s allowed %2$s</string>
    <string name="events_screen_rule_allowed_until">%1$s allowed %2$s until %3$s</string>
    <string name="events_screen_rule_blocked">%1$s blocked %2$s</string>
    <string name="events_screen_rule_reset">%1$s reset %2$s to the default</string>
    <!-- %1$s: the group's name or "the Google services screen …" -->
    <string name="events_screen_rule_no_bedtime">Couldn\'t allow %1$s until bedtime: no bedtime is coming up</string>
    <!-- Audience: parent. The lock sent the child back from a Google services screen. %1$s: a group's name
         (above), or a technical screen name (not translated); %2$s: the app it was opened from. -->
    <string name="events_blocked_area">Blocked %1$s</string>
    <string name="events_blocked_area_from">Blocked %1$s, opened from %2$s</string>
    <string name="events_blocked_screen">Blocked a Google services screen (%1$s)</string>
    <string name="events_blocked_screen_from">Blocked a Google services screen (%1$s), opened from %2$s</string>

    <!-- Audience: parent. "Parent screen view" (which lets parents see the screen) was switched off. "Fix setup
         over Wi-Fi" is a button in the parents' app: use the same words as that button. -->
    <string name="events_screen_view_restored">Screen view was switched off on the device (from Android\'s privacy review) and has been turned back on</string>
    <string name="events_screen_view_off">Screen view was switched off on the device. Use Fix setup over Wi-Fi to turn it back on</string>

    <!-- Audience: parent. Why a screenshot a parent asked for couldn't be taken. "Settings > Accessibility"
         should match Android's own menu names in this language; "Parent screen view" is this app's
         accessibility service as listed there. -->
    <string name="events_shot_no_service">Screen view isn\'t switched on. On the device, unlock parent mode and turn on Settings &gt; Accessibility &gt; Parent screen view</string>
    <string name="events_shot_screen_off">The screen is off</string>
    <string name="events_shot_failed">Couldn\'t capture the screen</string>
    <!-- %1$s: app name -->
    <string name="events_shot_secure">%1$s blocks screenshots</string>
    <string name="events_shot_secure_unknown">The app on screen blocks screenshots</string>
    <string name="events_shot_too_soon">Too soon after the last screenshot; try again</string>
    <!-- %1$d: Android's error code -->
    <string name="events_shot_error">Couldn\'t capture the screen (error %1$d)</string>

    <!-- Audience: parent. Why the device couldn't say where it is. -->
    <string name="events_location_off">Location is turned off on the device</string>
    <string name="events_location_no_provider">No location provider on the device</string>
    <string name="events_location_no_permission">The device has no location permission</string>
    <string name="events_location_no_fix">No location fix yet</string>

    <!-- Audience: parent. Why a usage report has no data; the parents' app adds advice after it. -->
    <string name="events_usage_not_allowed">The device hasn\'t allowed reading app use</string>

    <!-- Audience: parent. Calls. %1$s: the contact's name or the phone number. -->
    <string name="events_call_attempt">Tried to call %1$s (not on the safe list)</string>
    <string name="events_call_blocked">Blocked a call from %1$s</string>

    <!-- Audience: parent. A daily app time limit ran out. %1$s: list of the limits' names. -->
    <string name="events_times_up_today">Time\'s up for today: %1$s</string>

    <!-- Audience: parent. The schedule moved to another mode. %1$s: time it lasts until. -->
    <string name="events_mode_normal">Normal hours</string>
    <string name="events_mode_normal_until">Normal hours until %1$s</string>
    <string name="events_mode_limited_until">Limited hours until %1$s</string>
    <string name="events_mode_bedtime_until">Bedtime until %1$s</string>

    <!-- Audience: parent. Battery and power. %1$d: battery percentage. -->
    <string name="events_battery_low">Battery low: %1$d%%</string>
    <string name="events_turning_off">Turning off</string>
    <string name="events_turning_off_level">Turning off (battery %1$d%%)</string>
    <string name="events_turning_off_empty">Turning off: the battery is empty</string>

    <!-- Audience: parent. Changes on the device that cut it off or get around the lock. -->
    <string name="events_airplane_on">Airplane mode turned on (no calls or location updates until it\'s off)</string>
    <string name="events_airplane_off">Airplane mode turned off</string>
    <string name="events_mobile_data_on">Mobile data turned on</string>
    <string name="events_mobile_data_off">Mobile data turned off (only Wi-Fi from now on)</string>
    <!-- %1$s: app name -->
    <string name="events_installed">Installed %1$s</string>
    <string name="events_installed_parent_mode">Installed %1$s during parent mode</string>
    <string name="events_sim_removed">SIM card removed (no calls or mobile data)</string>
    <!-- %1$s: the mobile carriers' names -->
    <string name="events_sim_inserted">SIM card inserted (%1$s)</string>
    <string name="events_sim_changed">SIM card changed (now %1$s)</string>

    <!-- Audience: parent. An alert that reaches the parents late says when it happened. %1$s: the alert (one of
         the messages above); %2$s: the time it happened. -->
    <string name="events_late">%1$s (at %2$s)</string>

    <!-- Audience: child and parent. The name of a daily app time limit that has no name of its own and no apps. -->
    <string name="events_limit_apps">Apps</string>

    <!-- Audience: parent. Stands in for the caller in call events when the number is hidden, e.g.
         "Blocked a call from a private number" -->
    <string name="events_private_number">a private number</string>
</resources>
