<?xml version="1.0" encoding="utf-8"?>
<!-- Wording shared across the lock app (the child's phone). Each screen or feature keeps its own wording in
     its own strings_<area>.xml beside this file; every file here needs the same file, with the same names,
     in each values-<language> folder. Two audiences read it: the child (home, ring and emergency screens)
     and parents (parent mode, connections, diagnostics, and events sent to the parent app); comments say
     which when it matters. Names, app labels and anything typed by a person are never translated. -->
<resources>
    <!-- The app's name as Android shows it (the home screen picker, app info, the uninstall prompt). A product
         name, so it is never translated. -->
    <string name="app_name" translatable="false">PhoneLock</string>

    <!-- Common buttons: use these rather than adding another copy -->
    <string name="cancel">Cancel</string>
    <string name="ok">OK</string>
    <string name="done">Done</string>
    <string name="close">Close</string>

    <!-- Name of the accessibility service that lets parents view the screen, listed in Android's
         Settings > Accessibility on the child's phone (parent) -->
    <string name="screen_service_label">Parent screen view</string>

    <!-- Accessibility service description, shown to whoever opens Settings > Accessibility (parent) -->
    <string name="screen_service_description">Lets a parent see this screen when they ask, and keeps Google screens that leave the lock shut. Unfamiliar Google screens are sent to your parents as a picture. You get a notice each time.</string>
</resources>
