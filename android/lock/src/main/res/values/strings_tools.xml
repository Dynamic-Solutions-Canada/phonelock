<?xml version="1.0" encoding="utf-8"?>
<!-- Wording for the Wi-Fi and Bluetooth screens, parent file management, debugging, updates, contacts and the call log. -->
<resources>
    <!-- Audience: child. Shown when the Wi-Fi or Bluetooth screen closes because its time is over. %1$s is the
         screen's name, such as "Wi-Fi settings". -->
    <string name="tools_not_allowed_now">%1$s isn\'t allowed right now</string>

    <!-- Audience: child. The Wi-Fi screen, opened from its icon on the child's home screen. -->
    <!-- Title of the on/off card at the top of the Wi-Fi screen -->
    <string name="tools_wifi">Wi-Fi</string>
    <!-- State under the card title: the radio is on -->
    <string name="tools_on">On</string>
    <!-- State under the card title: the radio is off -->
    <string name="tools_off">Off</string>
    <string name="tools_wifi_switch_on_failed">Couldn\'t switch Wi-Fi on</string>
    <string name="tools_wifi_switch_off_failed">Couldn\'t switch Wi-Fi off</string>
    <!-- Heading above the list of nearby Wi-Fi networks -->
    <string name="tools_wifi_networks">Networks</string>
    <string name="tools_wifi_looking">Looking for networks…</string>
    <!-- Detail under a network's name: the phone is on this network now -->
    <string name="tools_wifi_connected">Connected</string>
    <!-- Detail under a network's name: the phone has joined it before and remembers it -->
    <string name="tools_wifi_saved">Saved</string>
    <!-- Detail under a network's name: it needs a password. Keep the lock symbol at the start. -->
    <string name="tools_wifi_secured">🔒 Password</string>
    <!-- Detail under a network's name: anyone can join, no password -->
    <string name="tools_wifi_open">Open</string>
    <!-- Dialog title. %1$s is the Wi-Fi network's name. -->
    <string name="tools_wifi_forget_title">Forget %1$s?</string>
    <!-- Button: remove a saved Wi-Fi network from the phone -->
    <string name="tools_wifi_forget">Forget</string>
    <string name="tools_wifi_forget_hint">Hold a saved network to forget it.</string>
    <!-- Hint in the box where the child types the Wi-Fi password -->
    <string name="tools_wifi_password_hint">Password</string>
    <!-- Button: join the Wi-Fi network with the password typed -->
    <string name="tools_wifi_join">Join</string>
    <!-- %1$s is the Wi-Fi network's name -->
    <string name="tools_wifi_join_failed">Couldn\'t join %1$s</string>
    <!-- %1$s is the Wi-Fi network's name -->
    <string name="tools_wifi_wrong_password">Wrong password for %1$s</string>

    <!-- Audience: child. The Bluetooth screen, opened from its icon on the child's home screen. -->
    <!-- Title of the on/off card at the top of the Bluetooth screen -->
    <string name="tools_bluetooth">Bluetooth</string>
    <string name="tools_bluetooth_switch_on_failed">Couldn\'t switch Bluetooth on</string>
    <string name="tools_bluetooth_switch_off_failed">Couldn\'t switch Bluetooth off</string>
    <!-- Heading above the list of paired Bluetooth devices -->
    <string name="tools_bluetooth_your_devices">Your devices</string>
    <!-- Shown under "Your devices" when nothing is paired -->
    <string name="tools_bluetooth_none_yet">None yet.</string>
    <!-- Button: start looking for headphones or speakers to pair -->
    <string name="tools_bluetooth_pair_new">Pair a new device</string>
    <!-- Heading above Bluetooth devices found nearby -->
    <string name="tools_bluetooth_nearby">Nearby</string>
    <string name="tools_bluetooth_pairing_mode">Put the headphones or speaker in pairing mode, then tap it.</string>
    <!-- Detail under a nearby device's name -->
    <string name="tools_bluetooth_tap_to_pair">Tap to pair</string>
    <string name="tools_bluetooth_searching">Searching…</string>
    <string name="tools_bluetooth_search_again">Search again</string>
    <string name="tools_bluetooth_none_found">No devices found.</string>
    <!-- %1$s is the Bluetooth device's name -->
    <string name="tools_bluetooth_pairing">Pairing with %1$s…</string>
    <string name="tools_bluetooth_pairing_failed_start">Couldn\'t start pairing</string>
    <!-- %1$s is the Bluetooth device's name -->
    <string name="tools_bluetooth_paired">Paired with %1$s</string>
    <!-- %1$s is the Bluetooth device's name. Devices that show a code are phones and computers; they need Android's pairing screen, which only a parent can open. -->
    <string name="tools_bluetooth_pair_failed">Couldn\'t pair with %1$s. Devices that show a code need a parent.</string>

    <!-- Audience: parent. News sent to the parent app when the child changes Wi-Fi or Bluetooth. -->
    <string name="tools_wifi_switched_off_event">Wi-Fi was switched off on the phone</string>
    <!-- %1$s is the Wi-Fi network's name -->
    <string name="tools_wifi_joined_event">Joined a new Wi-Fi network: %1$s</string>
    <!-- %1$s is the Wi-Fi network's name -->
    <string name="tools_wifi_forgot_event">Forgot the Wi-Fi network %1$s</string>
    <!-- %1$s is the Bluetooth device's name -->
    <string name="tools_bluetooth_paired_event">Paired a new Bluetooth device: %1$s</string>

    <!-- Audience: child and parent. A parent changed files on the device: shown to the child as a notice and to the
         parents in their activity list. %1$s is the parent's name; %2$s is a file or folder path. -->
    <string name="tools_files_created_folder">%1$s created folder %2$s</string>
    <string name="tools_files_deleted">%1$s deleted %2$s</string>
    <!-- %3$s is the new name -->
    <string name="tools_files_renamed">%1$s renamed %2$s to %3$s</string>
    <string name="tools_files_added">%1$s added %2$s</string>

    <!-- Audience: parent. Why a file action a parent asked for failed, shown in the parent app's file screen. -->
    <string name="tools_files_not_permitted">The device hasn\'t allowed file access yet</string>
    <string name="tools_files_location_unavailable">That location isn\'t available</string>
    <string name="tools_files_create_folder_failed">Couldn\'t create the folder</string>
    <string name="tools_files_top_level">Top-level folders can\'t be deleted; open it and delete what\'s inside</string>
    <!-- The new name typed for a file or folder is empty or contains a slash -->
    <string name="tools_files_invalid_name">Not a valid name</string>
    <string name="tools_files_name_taken">That name is taken</string>
    <string name="tools_files_rename_failed">Couldn\'t rename it</string>
    <string name="tools_files_no_upload">No file came with the upload</string>
    <string name="tools_files_generic_error">Something went wrong</string>
    <!-- %1$s is a file name -->
    <string name="tools_files_delete_failed">Couldn\'t delete %1$s</string>
    <string name="tools_files_unknown_server">Upload came from an unknown server</string>
    <string name="tools_files_save_failed">Couldn\'t save the file</string>
    <!-- The path the parent asked to download is a folder, not a file -->
    <string name="tools_files_not_a_file">Not a file</string>
    <string name="tools_files_too_large">Too large to send (over 48 MB)</string>
    <!-- "Hub" is the relay server that carries messages between the phone and the parent app. %1$d is an HTTP status code. -->
    <string name="tools_files_upload_failed">Upload to the hub failed (HTTP %1$d)</string>

    <!-- Audience: parent. Answers to a parent's request for the contacts or the call log. -->
    <string name="tools_contacts_not_permitted">The device hasn\'t allowed reading its contacts</string>
    <string name="tools_calllog_not_permitted">The device hasn\'t allowed reading its call log</string>

    <!-- Audience: parent. Events about turning on debugging so the phone can be repaired from a computer. -->
    <!-- "Fix setup over Wi-Fi" is a button in the parent app: use the same wording as that button. -->
    <string name="tools_debug_needs_fix_setup">Couldn\'t turn on debugging: the device needs Fix setup over Wi-Fi first</string>
    <!-- %1$s is Android's reason, usually in English -->
    <string name="tools_debug_failed">Couldn\'t turn on debugging: %1$s</string>
    <!-- %1$s is the parent's name; %2$s is a time of day; %3$s is an IP address and %4$s a port number. "Wireless debugging" is an Android setting: use Android's own name for it in this language. -->
    <string name="tools_debug_on_with_address">%1$s turned on USB and wireless debugging until %2$s. Wireless debugging: %3$s:%4$s.</string>
    <!-- %1$s is the parent's name; %2$s is a time of day. "Wireless debugging" is an Android setting: use Android's own name for it in this language. -->
    <string name="tools_debug_on_starting">%1$s turned on USB and wireless debugging until %2$s. Wireless debugging is starting.</string>
    <string name="tools_debug_off">Debugging turned off again</string>

    <!-- Audience: parent. Events about updating the lock app on the phone. -->
    <!-- %1$d is the app's version number -->
    <string name="tools_update_up_to_date">Already up to date (version %1$d)</string>
    <!-- %1$d is the app's version number -->
    <string name="tools_update_downloaded">Version %1$d downloaded; it installs the next time the screen is off</string>
    <!-- %1$s is the reason, sometimes Android's own in English -->
    <string name="tools_update_check_failed">Couldn\'t check for an update: %1$s</string>
    <!-- %1$d is the app's version number; %2$s is the reason, sometimes Android's own in English -->
    <string name="tools_update_install_version_failed">Couldn\'t install update %1$d: %2$s</string>
    <!-- %1$s is Android's reason, usually in English -->
    <string name="tools_update_install_failed">Couldn\'t install the update: %1$s</string>
    <!-- Android wanted to show a confirmation on the phone, which the lock app doesn't allow -->
    <string name="tools_update_install_failed_asked">Couldn\'t install the update: the device wanted to ask first</string>
    <!-- %1$d is the app's version number -->
    <string name="tools_update_updated">Updated to version %1$d</string>
    <!-- Reasons a downloaded update was rejected, shown after "Couldn't check for an update:" -->
    <string name="tools_update_too_large">Update is too large</string>
    <string name="tools_update_checksum">Update checksum doesn\'t match</string>
    <string name="tools_update_store_failed">Couldn\'t store the update</string>
    <string name="tools_update_wrong_app">Update isn\'t this app</string>
    <string name="tools_update_wrong_version">Update version doesn\'t match</string>
    <string name="tools_update_wrong_key">Update isn\'t signed with this app\'s key</string>
</resources>
