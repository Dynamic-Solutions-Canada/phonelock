<?xml version="1.0" encoding="utf-8"?>
<!-- Wording for the Wi-Fi and Bluetooth screens, parent file management, debugging, updates, contacts and the call log. -->
<resources>
    <!-- Audience: child. Shown when the Wi-Fi or Bluetooth screen closes because its time is over. %1$s is the
         screen's name, such as "Wi-Fi settings". -->
    <string name="tools_not_allowed_now">Não dá para usar %1$s agora</string>

    <!-- Audience: child. The Wi-Fi screen, opened from its icon on the child's home screen. -->
    <!-- Title of the on/off card at the top of the Wi-Fi screen -->
    <string name="tools_wifi">Wi-Fi</string>
    <!-- State under the card title: the radio is on -->
    <string name="tools_on">Ligado</string>
    <!-- State under the card title: the radio is off -->
    <string name="tools_off">Desligado</string>
    <string name="tools_wifi_switch_on_failed">Não foi possível ligar o Wi-Fi</string>
    <string name="tools_wifi_switch_off_failed">Não foi possível desligar o Wi-Fi</string>
    <!-- Heading above the list of nearby Wi-Fi networks -->
    <string name="tools_wifi_networks">Redes</string>
    <string name="tools_wifi_looking">Procurando redes…</string>
    <!-- Detail under a network's name: the phone is on this network now -->
    <string name="tools_wifi_connected">Conectado</string>
    <!-- Detail under a network's name: the phone has joined it before and remembers it -->
    <string name="tools_wifi_saved">Salva</string>
    <!-- Detail under a network's name: it needs a password. Keep the lock symbol at the start. -->
    <string name="tools_wifi_secured">🔒 Senha</string>
    <!-- Detail under a network's name: anyone can join, no password -->
    <string name="tools_wifi_open">Aberta</string>
    <!-- Dialog title. %1$s is the Wi-Fi network's name. -->
    <string name="tools_wifi_forget_title">Esquecer %1$s?</string>
    <!-- Button: remove a saved Wi-Fi network from the phone -->
    <string name="tools_wifi_forget">Esquecer</string>
    <string name="tools_wifi_forget_hint">Segure uma rede salva para esquecê-la.</string>
    <!-- Hint in the box where the child types the Wi-Fi password -->
    <string name="tools_wifi_password_hint">Senha</string>
    <!-- Button: join the Wi-Fi network with the password typed -->
    <string name="tools_wifi_join">Conectar</string>
    <!-- %1$s is the Wi-Fi network's name -->
    <string name="tools_wifi_join_failed">Não foi possível conectar a %1$s</string>
    <!-- %1$s is the Wi-Fi network's name -->
    <string name="tools_wifi_wrong_password">Senha errada para %1$s</string>

    <!-- Audience: child. The Bluetooth screen, opened from its icon on the child's home screen. -->
    <!-- Title of the on/off card at the top of the Bluetooth screen -->
    <string name="tools_bluetooth">Bluetooth</string>
    <string name="tools_bluetooth_switch_on_failed">Não foi possível ligar o Bluetooth</string>
    <string name="tools_bluetooth_switch_off_failed">Não foi possível desligar o Bluetooth</string>
    <!-- Heading above the list of paired Bluetooth devices -->
    <string name="tools_bluetooth_your_devices">Seus dispositivos</string>
    <!-- Shown under "Your devices" when nothing is paired -->
    <string name="tools_bluetooth_none_yet">Nenhum ainda.</string>
    <!-- Button: start looking for headphones or speakers to pair -->
    <string name="tools_bluetooth_pair_new">Parear novo dispositivo</string>
    <!-- Heading above Bluetooth devices found nearby -->
    <string name="tools_bluetooth_nearby">Por perto</string>
    <string name="tools_bluetooth_pairing_mode">Coloque o fone ou a caixa de som no modo de pareamento e toque nele.</string>
    <!-- Detail under a nearby device's name -->
    <string name="tools_bluetooth_tap_to_pair">Toque para parear</string>
    <string name="tools_bluetooth_searching">Procurando…</string>
    <string name="tools_bluetooth_search_again">Procurar de novo</string>
    <string name="tools_bluetooth_none_found">Nenhum dispositivo encontrado.</string>
    <!-- %1$s is the Bluetooth device's name -->
    <string name="tools_bluetooth_pairing">Pareando com %1$s…</string>
    <string name="tools_bluetooth_pairing_failed_start">Não foi possível começar o pareamento</string>
    <!-- %1$s is the Bluetooth device's name -->
    <string name="tools_bluetooth_paired">Pareado com %1$s</string>
    <!-- %1$s is the Bluetooth device's name. Devices that show a code are phones and computers; they need Android's pairing screen, which only a parent can open. -->
    <string name="tools_bluetooth_pair_failed">Não foi possível parear com %1$s. Dispositivos que mostram um código precisam de um responsável.</string>

    <!-- Audience: parent. News sent to the parent app when the child changes Wi-Fi or Bluetooth. -->
    <string name="tools_wifi_switched_off_event">O Wi-Fi foi desligado no celular</string>
    <!-- %1$s is the Wi-Fi network's name -->
    <string name="tools_wifi_joined_event">Entrou em uma nova rede Wi-Fi: %1$s</string>
    <!-- %1$s is the Wi-Fi network's name -->
    <string name="tools_wifi_forgot_event">Esqueceu a rede Wi-Fi %1$s</string>
    <!-- %1$s is the Bluetooth device's name -->
    <string name="tools_bluetooth_paired_event">Pareou um novo dispositivo Bluetooth: %1$s</string>

    <!-- Audience: child and parent. A parent changed files on the device: shown to the child as a notice and to the
         parents in their activity list. %1$s is the parent's name; %2$s is a file or folder path. -->
    <string name="tools_files_created_folder">%1$s criou a pasta %2$s</string>
    <string name="tools_files_deleted">%1$s excluiu %2$s</string>
    <!-- %3$s is the new name -->
    <string name="tools_files_renamed">%1$s renomeou %2$s para %3$s</string>
    <string name="tools_files_added">%1$s adicionou %2$s</string>

    <!-- Audience: parent. Why a file action a parent asked for failed, shown in the parent app's file screen. -->
    <string name="tools_files_not_permitted">O dispositivo ainda não permitiu o acesso aos arquivos</string>
    <string name="tools_files_location_unavailable">Esse local não está disponível</string>
    <string name="tools_files_create_folder_failed">Não foi possível criar a pasta</string>
    <string name="tools_files_top_level">Pastas principais não podem ser excluídas; abra a pasta e exclua o que há nela</string>
    <!-- The new name typed for a file or folder is empty or contains a slash -->
    <string name="tools_files_invalid_name">Nome inválido</string>
    <string name="tools_files_name_taken">Esse nome já existe</string>
    <string name="tools_files_rename_failed">Não foi possível renomear</string>
    <string name="tools_files_no_upload">Nenhum arquivo veio com o envio</string>
    <string name="tools_files_generic_error">Algo deu errado</string>
    <!-- %1$s is a file name -->
    <string name="tools_files_delete_failed">Não foi possível excluir %1$s</string>
    <string name="tools_files_unknown_server">O envio veio de um servidor desconhecido</string>
    <string name="tools_files_save_failed">Não foi possível salvar o arquivo</string>
    <!-- The path the parent asked to download is a folder, not a file -->
    <string name="tools_files_not_a_file">Não é um arquivo</string>
    <string name="tools_files_too_large">Grande demais para enviar (mais de 48 MB)</string>
    <!-- "Hub" is the relay server that carries messages between the phone and the parent app. %1$d is an HTTP status code. -->
    <string name="tools_files_upload_failed">Falha no envio para o hub (HTTP %1$d)</string>

    <!-- Audience: parent. Answers to a parent's request for the contacts or the call log. -->
    <string name="tools_contacts_not_permitted">O dispositivo ainda não permitiu a leitura dos contatos</string>
    <string name="tools_calllog_not_permitted">O dispositivo ainda não permitiu a leitura do registro de chamadas</string>

    <!-- Audience: parent. Events about turning on debugging so the phone can be repaired from a computer. -->
    <!-- "Fix setup over Wi-Fi" is a button in the parent app: use the same wording as that button. -->
    <string name="tools_debug_needs_fix_setup">Não foi possível ativar a depuração: primeiro o dispositivo precisa de Corrigir configuração por Wi-Fi</string>
    <!-- %1$s is Android's reason, usually in English -->
    <string name="tools_debug_failed">Não foi possível ativar a depuração: %1$s</string>
    <!-- %1$s is the parent's name; %2$s is a time of day; %3$s is an IP address and %4$s a port number. "Wireless debugging" is an Android setting: use Android's own name for it in this language. -->
    <string name="tools_debug_on_with_address">%1$s ativou a depuração USB e por Wi-Fi até %2$s. Depuração por Wi-Fi: %3$s:%4$s.</string>
    <!-- %1$s is the parent's name; %2$s is a time of day. "Wireless debugging" is an Android setting: use Android's own name for it in this language. -->
    <string name="tools_debug_on_starting">%1$s ativou a depuração USB e por Wi-Fi até %2$s. A depuração por Wi-Fi está iniciando.</string>
    <string name="tools_debug_off">A depuração foi desativada de novo</string>

    <!-- Audience: parent. Events about updating the lock app on the phone. -->
    <!-- %1$d is the app's version number -->
    <string name="tools_update_up_to_date">Já está atualizado (versão %1$d)</string>
    <!-- %1$d is the app's version number -->
    <string name="tools_update_downloaded">Versão %1$d baixada; será instalada na próxima vez que a tela desligar</string>
    <!-- %1$s is the reason, sometimes Android's own in English -->
    <string name="tools_update_check_failed">Não foi possível procurar atualização: %1$s</string>
    <!-- %1$d is the app's version number; %2$s is the reason, sometimes Android's own in English -->
    <string name="tools_update_install_version_failed">Não foi possível instalar a atualização %1$d: %2$s</string>
    <!-- %1$s is Android's reason, usually in English -->
    <string name="tools_update_install_failed">Não foi possível instalar a atualização: %1$s</string>
    <!-- Android wanted to show a confirmation on the phone, which the lock app doesn't allow -->
    <string name="tools_update_install_failed_asked">Não foi possível instalar a atualização: o dispositivo queria pedir confirmação antes</string>
    <!-- %1$d is the app's version number -->
    <string name="tools_update_updated">Atualizado para a versão %1$d</string>
    <!-- Reasons a downloaded update was rejected, shown after "Couldn't check for an update:" -->
    <string name="tools_update_too_large">a atualização é grande demais</string>
    <string name="tools_update_checksum">o checksum da atualização não confere</string>
    <string name="tools_update_store_failed">não foi possível armazenar a atualização</string>
    <string name="tools_update_wrong_app">a atualização não é deste app</string>
    <string name="tools_update_wrong_version">a versão da atualização não confere</string>
    <string name="tools_update_wrong_key">a atualização não foi assinada com a chave deste app</string>
</resources>
