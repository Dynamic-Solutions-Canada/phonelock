<?xml version="1.0" encoding="utf-8"?>
<!-- Wording for the Wi-Fi and Bluetooth screens, parent file management, debugging, updates, contacts and the call log. -->
<resources>
    <!-- Audience: child. Shown when the Wi-Fi or Bluetooth screen closes because its time is over. %1$s is the
         screen's name, such as "Wi-Fi settings". -->
    <string name="tools_not_allowed_now">%1$s は今は使えません</string>

    <!-- Audience: child. The Wi-Fi screen, opened from its icon on the child's home screen. -->
    <!-- Title of the on/off card at the top of the Wi-Fi screen -->
    <string name="tools_wifi">Wi-Fi</string>
    <!-- State under the card title: the radio is on -->
    <string name="tools_on">オン</string>
    <!-- State under the card title: the radio is off -->
    <string name="tools_off">オフ</string>
    <string name="tools_wifi_switch_on_failed">Wi-Fi をオンにできませんでした</string>
    <string name="tools_wifi_switch_off_failed">Wi-Fi をオフにできませんでした</string>
    <!-- Heading above the list of nearby Wi-Fi networks -->
    <string name="tools_wifi_networks">ネットワーク</string>
    <string name="tools_wifi_looking">ネットワークをさがしています…</string>
    <!-- Detail under a network's name: the phone is on this network now -->
    <string name="tools_wifi_connected">接続済み</string>
    <!-- Detail under a network's name: the phone has joined it before and remembers it -->
    <string name="tools_wifi_saved">保存済み</string>
    <!-- Detail under a network's name: it needs a password. Keep the lock symbol at the start. -->
    <string name="tools_wifi_secured">🔒 パスワード</string>
    <!-- Detail under a network's name: anyone can join, no password -->
    <string name="tools_wifi_open">パスワードなし</string>
    <!-- Dialog title. %1$s is the Wi-Fi network's name. -->
    <string name="tools_wifi_forget_title">%1$s を削除しますか？</string>
    <!-- Button: remove a saved Wi-Fi network from the phone -->
    <string name="tools_wifi_forget">削除</string>
    <string name="tools_wifi_forget_hint">保存したネットワークを長押しすると削除できます。</string>
    <!-- Hint in the box where the child types the Wi-Fi password -->
    <string name="tools_wifi_password_hint">パスワード</string>
    <!-- Button: join the Wi-Fi network with the password typed -->
    <string name="tools_wifi_join">接続</string>
    <!-- %1$s is the Wi-Fi network's name -->
    <string name="tools_wifi_join_failed">%1$s に接続できませんでした</string>
    <!-- %1$s is the Wi-Fi network's name -->
    <string name="tools_wifi_wrong_password">%1$s のパスワードがちがいます</string>

    <!-- Audience: child. The Bluetooth screen, opened from its icon on the child's home screen. -->
    <!-- Title of the on/off card at the top of the Bluetooth screen -->
    <string name="tools_bluetooth">Bluetooth</string>
    <string name="tools_bluetooth_switch_on_failed">Bluetooth をオンにできませんでした</string>
    <string name="tools_bluetooth_switch_off_failed">Bluetooth をオフにできませんでした</string>
    <!-- Heading above the list of paired Bluetooth devices -->
    <string name="tools_bluetooth_your_devices">自分のデバイス</string>
    <!-- Shown under "Your devices" when nothing is paired -->
    <string name="tools_bluetooth_none_yet">まだありません。</string>
    <!-- Button: start looking for headphones or speakers to pair -->
    <string name="tools_bluetooth_pair_new">新しいデバイスとペア設定</string>
    <!-- Heading above Bluetooth devices found nearby -->
    <string name="tools_bluetooth_nearby">近くのデバイス</string>
    <string name="tools_bluetooth_pairing_mode">ヘッドホンやスピーカーをペア設定モードにしてから、タップしてください。</string>
    <!-- Detail under a nearby device's name -->
    <string name="tools_bluetooth_tap_to_pair">タップしてペア設定</string>
    <string name="tools_bluetooth_searching">さがしています…</string>
    <string name="tools_bluetooth_search_again">もう一度さがす</string>
    <string name="tools_bluetooth_none_found">デバイスが見つかりませんでした。</string>
    <!-- %1$s is the Bluetooth device's name -->
    <string name="tools_bluetooth_pairing">%1$s とペア設定しています…</string>
    <string name="tools_bluetooth_pairing_failed_start">ペア設定を始められませんでした</string>
    <!-- %1$s is the Bluetooth device's name -->
    <string name="tools_bluetooth_paired">%1$s とペア設定しました</string>
    <!-- %1$s is the Bluetooth device's name. Devices that show a code are phones and computers; they need Android's pairing screen, which only a parent can open. -->
    <string name="tools_bluetooth_pair_failed">%1$s とペア設定できませんでした。コードが出るデバイスは、おうちの人にたのんでください。</string>

    <!-- Audience: parent. News sent to the parent app when the child changes Wi-Fi or Bluetooth. -->
    <string name="tools_wifi_switched_off_event">スマートフォンで Wi-Fi がオフにされました</string>
    <!-- %1$s is the Wi-Fi network's name -->
    <string name="tools_wifi_joined_event">新しい Wi-Fi ネットワークに接続しました：%1$s</string>
    <!-- %1$s is the Wi-Fi network's name -->
    <string name="tools_wifi_forgot_event">Wi-Fi ネットワーク %1$s を削除しました</string>
    <!-- %1$s is the Bluetooth device's name -->
    <string name="tools_bluetooth_paired_event">新しい Bluetooth デバイスとペア設定しました：%1$s</string>

    <!-- Audience: child and parent. A parent changed files on the device: shown to the child as a notice and to the
         parents in their activity list. %1$s is the parent's name; %2$s is a file or folder path. -->
    <string name="tools_files_created_folder">%1$s がフォルダ %2$s を作成しました</string>
    <string name="tools_files_deleted">%1$s が %2$s を削除しました</string>
    <!-- %3$s is the new name -->
    <string name="tools_files_renamed">%1$s が %2$s の名前を %3$s に変更しました</string>
    <string name="tools_files_added">%1$s が %2$s を追加しました</string>

    <!-- Audience: parent. Why a file action a parent asked for failed, shown in the parent app's file screen. -->
    <string name="tools_files_not_permitted">デバイスでファイルへのアクセスがまだ許可されていません</string>
    <string name="tools_files_location_unavailable">その場所は利用できません</string>
    <string name="tools_files_create_folder_failed">フォルダを作成できませんでした</string>
    <string name="tools_files_top_level">最上位のフォルダは削除できません。フォルダを開いて中身を削除してください</string>
    <!-- The new name typed for a file or folder is empty or contains a slash -->
    <string name="tools_files_invalid_name">無効な名前です</string>
    <string name="tools_files_name_taken">その名前はすでに使われています</string>
    <string name="tools_files_rename_failed">名前を変更できませんでした</string>
    <string name="tools_files_no_upload">アップロードにファイルが含まれていませんでした</string>
    <string name="tools_files_generic_error">問題が発生しました</string>
    <!-- %1$s is a file name -->
    <string name="tools_files_delete_failed">%1$s を削除できませんでした</string>
    <string name="tools_files_unknown_server">不明なサーバーからのアップロードです</string>
    <string name="tools_files_save_failed">ファイルを保存できませんでした</string>
    <!-- The path the parent asked to download is a folder, not a file -->
    <string name="tools_files_not_a_file">ファイルではありません</string>
    <string name="tools_files_too_large">サイズが大きすぎるため送信できません（48 MB 超）</string>
    <!-- "Hub" is the relay server that carries messages between the phone and the parent app. %1$d is an HTTP status code. -->
    <string name="tools_files_upload_failed">リレーサーバーへのアップロードに失敗しました（HTTP %1$d）</string>

    <!-- Audience: parent. Answers to a parent's request for the contacts or the call log. -->
    <string name="tools_contacts_not_permitted">デバイスで連絡先の読み取りが許可されていません</string>
    <string name="tools_calllog_not_permitted">デバイスで通話履歴の読み取りが許可されていません</string>

    <!-- Audience: parent. Events about turning on debugging so the phone can be repaired from a computer. -->
    <!-- "Fix setup over Wi-Fi" is a button in the parent app: use the same wording as that button. -->
    <string name="tools_debug_needs_fix_setup">デバッグをオンにできませんでした：先にデバイスで「Wi-Fi でセットアップを修復」を行う必要があります</string>
    <!-- %1$s is Android's reason, usually in English -->
    <string name="tools_debug_failed">デバッグをオンにできませんでした：%1$s</string>
    <!-- %1$s is the parent's name; %2$s is a time of day; %3$s is an IP address and %4$s a port number. "Wireless debugging" is an Android setting: use Android's own name for it in this language. -->
    <string name="tools_debug_on_with_address">%1$s が %2$s まで USB デバッグとワイヤレス デバッグをオンにしました。ワイヤレス デバッグ：%3$s:%4$s。</string>
    <!-- %1$s is the parent's name; %2$s is a time of day. "Wireless debugging" is an Android setting: use Android's own name for it in this language. -->
    <string name="tools_debug_on_starting">%1$s が %2$s まで USB デバッグとワイヤレス デバッグをオンにしました。ワイヤレス デバッグを開始しています。</string>
    <string name="tools_debug_off">デバッグがオフに戻りました</string>

    <!-- Audience: parent. Events about updating the lock app on the phone. -->
    <!-- %1$d is the app's version number -->
    <string name="tools_update_up_to_date">すでに最新です（バージョン %1$d）</string>
    <!-- %1$d is the app's version number -->
    <string name="tools_update_downloaded">バージョン %1$d をダウンロードしました。次に画面がオフになったときにインストールされます</string>
    <!-- %1$s is the reason, sometimes Android's own in English -->
    <string name="tools_update_check_failed">アップデートを確認できませんでした：%1$s</string>
    <!-- %1$d is the app's version number; %2$s is the reason, sometimes Android's own in English -->
    <string name="tools_update_install_version_failed">アップデート %1$d をインストールできませんでした：%2$s</string>
    <!-- %1$s is Android's reason, usually in English -->
    <string name="tools_update_install_failed">アップデートをインストールできませんでした：%1$s</string>
    <!-- Android wanted to show a confirmation on the phone, which the lock app doesn't allow -->
    <string name="tools_update_install_failed_asked">アップデートをインストールできませんでした：デバイスが先に確認を求めました</string>
    <!-- %1$d is the app's version number -->
    <string name="tools_update_updated">バージョン %1$d にアップデートしました</string>
    <!-- Reasons a downloaded update was rejected, shown after "Couldn't check for an update:" -->
    <string name="tools_update_too_large">アップデートのサイズが大きすぎます</string>
    <string name="tools_update_checksum">アップデートのチェックサムが一致しません</string>
    <string name="tools_update_store_failed">アップデートを保存できませんでした</string>
    <string name="tools_update_wrong_app">アップデートはこのアプリのものではありません</string>
    <string name="tools_update_wrong_version">アップデートのバージョンが一致しません</string>
    <string name="tools_update_wrong_key">アップデートはこのアプリの鍵で署名されていません</string>
</resources>
