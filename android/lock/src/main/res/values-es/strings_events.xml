<?xml version="1.0" encoding="utf-8"?>
<!-- Events the lock app reports to the parents' app, and the notices it posts on the child's phone about them. -->
<resources>

    <!-- ========== Shared ========== -->

    <!-- Audience: child and parent. Stands in for a parent's name when a command came without one; used as
         the parent's name in the strings below. -->
    <string name="events_a_parent">Un padre o madre</string>

    <!-- Audience: child and parent. Wi-Fi and Bluetooth appear on the home screen and in the parents' app list
         as if they were apps; these are their names. They open the screens where she can change Wi-Fi or
         Bluetooth settings. -->
    <string name="events_wifi_settings">Ajustes de Wi-Fi</string>
    <string name="events_bluetooth_settings">Ajustes de Bluetooth</string>

    <!-- Audience: child (home screen) and parent. The current schedule mode's name. -->
    <string name="events_mode_label_normal">Normal</string>
    <string name="events_mode_label_limited">Horario limitado</string>
    <string name="events_mode_label_bedtime">Hora de dormir</string>

    <!-- ========== Notifications on the child's phone ========== -->

    <!-- Audience: child. Notification channel names, shown in Android's notification settings. -->
    <string name="events_channel_from_parents">De tus padres</string>
    <string name="events_channel_parent_controls">Control parental</string>
    <!-- Audience: child. The permanent notification while the lock is running. -->
    <string name="events_parent_controls_active">Control parental activo</string>

    <!-- Audience: child. A parent changed something. In each, the last placeholder in brackets is the parent's
         name; %1$s is an app's name where there is one; times are already formatted (e.g. 6:00 PM). -->
    <string name="events_allowed_until_child">Puedes usar %1$s hasta %2$s (%3$s)</string>
    <string name="events_turned_off_child">Ya no puedes usar %1$s</string>
    <string name="events_all_turned_off_child">Ya no puedes usar las aplicaciones extra</string>
    <string name="events_paused_until_child">%1$s en pausa hasta %2$s (%3$s)</string>
    <string name="events_back_child">Ya puedes volver a usar %1$s (%2$s)</string>
    <!-- %1$s: the app she asked for; %2$s: parent's name -->
    <string name="events_declined_child">Te han dicho que no a %1$s (%2$s)</string>
    <!-- %1$s: parent's name -->
    <string name="events_declined_any_child">Te han dicho que no a una aplicación (%1$s)</string>
    <!-- %1$s: time; %2$s: parent's name -->
    <string name="events_limited_started_child">Empieza el horario limitado hasta %1$s (%2$s)</string>
    <string name="events_bedtime_started_child">Empieza la hora de dormir hasta %1$s (%2$s)</string>
    <!-- %1$s: parent's name -->
    <string name="events_manual_mode_ended_child">Se acabó el horario limitado o la hora de dormir (%1$s)</string>
    <string name="events_parent_mode_ended_child">Se acabó el modo padres (%1$s)</string>
    <!-- %1$s: time; %2$s: parent's name -->
    <string name="events_parent_mode_on_child">Modo padres activado hasta %1$s (%2$s)</string>
    <!-- %1$s: parent's name; %2$s: contact's name -->
    <string name="events_contact_added_child">%1$s ha añadido a %2$s a tus contactos</string>
    <string name="events_contact_removed_child">%1$s ha quitado a %2$s de tus contactos</string>
    <!-- %1$s: parent's name; %2$s: app name -->
    <string name="events_uninstalled_child">%1$s ha desinstalado %2$s</string>
    <!-- %1$s: parent's name -->
    <string name="events_screen_viewed_child">%1$s ha visto tu pantalla</string>

    <!-- Audience: child. A Google services screen she opened was sent to her parents as a picture. -->
    <string name="events_screen_picture_sent">Se ha enviado una imagen de esta pantalla a tus padres</string>

    <!-- Audience: child. %1$s: the contact's name or the phone number she tried to call. -->
    <string name="events_call_not_allowed_child">No puedes llamar a %1$s. Pide a tu padre o a tu madre que lo añada a tu lista de confianza.</string>

    <!-- Audience: child. A daily app time limit is nearly used up. %1$d: minutes left; %2$s: the limit's name
         (an app name, or a group name a parent chose). -->
    <plurals name="events_minutes_left_today">
        <item quantity="one">Hoy te queda %1$d minuto de %2$s</item>
        <item quantity="many">Hoy te quedan %1$d minutos de %2$s</item>
        <item quantity="other">Hoy te quedan %1$d minutos de %2$s</item>
    </plurals>
    <!-- Audience: child. %1$s: the limits that ran out, as a list of names. -->
    <string name="events_times_up_today_child">Se acabó el tiempo de hoy: %1$s. Si necesitas más, pídeselo a tu padre o a tu madre.</string>

    <!-- ========== Shown to both ========== -->

    <!-- Audience: child and parent. Apps a parent allowed for a while have run out. %1$s: list of app names. -->
    <string name="events_times_up">Se acabó el tiempo: %1$s</string>
    <!-- Audience: child and parent. Apps a parent paused for a while are allowed again. %1$s: list of app
         names; the count is how many apps. -->
    <plurals name="events_apps_back">
        <item quantity="one">%1$s vuelve a estar disponible</item>
        <item quantity="many">%1$s vuelven a estar disponibles</item>
        <item quantity="other">%1$s vuelven a estar disponibles</item>
    </plurals>

    <!-- ========== Events sent to the parents' app ========== -->

    <!-- Audience: parent. What a parent did, shown in the other parent's activity list. %1$s is always the
         parent's name; %2$s an app's name; times are already formatted (e.g. 6:00 PM). -->
    <string name="events_allowed_until">%1$s: ha permitido %2$s hasta %3$s</string>
    <string name="events_turned_off">%1$s: ha detenido %2$s</string>
    <string name="events_all_turned_off">%1$s: ha detenido todas las aplicaciones permitidas un rato</string>
    <string name="events_paused_until">%1$s: ha pausado %2$s hasta %3$s</string>
    <string name="events_back">%1$s: ha vuelto a permitir %2$s</string>
    <!-- %2$s: the app the child asked for -->
    <string name="events_declined">%1$s: ha denegado la solicitud de %2$s</string>
    <string name="events_declined_any">%1$s: ha denegado una solicitud de aplicación</string>
    <string name="events_home_added">%1$s: ha añadido %2$s a la pantalla de inicio</string>
    <string name="events_home_removed">%1$s: ha quitado %2$s de la pantalla de inicio</string>
    <!-- When an app may be used: in normal hours, limited hours and bedtime (the schedule's three modes), or
         only when a parent allows it for a while. -->
    <string name="events_appmode_none">%1$s: %2$s se bloquea salvo cuando se permite un rato</string>
    <string name="events_appmode_all">%1$s: %2$s se permite siempre</string>
    <string name="events_appmode_normal">%1$s: %2$s se permite en horario normal</string>
    <string name="events_appmode_limited">%1$s: %2$s se permite en horario limitado</string>
    <string name="events_appmode_bedtime">%1$s: %2$s se permite en hora de dormir</string>
    <string name="events_appmode_normal_limited">%1$s: %2$s se permite en horario normal y horario limitado</string>
    <string name="events_appmode_normal_bedtime">%1$s: %2$s se permite en horario normal y hora de dormir</string>
    <string name="events_appmode_limited_bedtime">%1$s: %2$s se permite en horario limitado y hora de dormir</string>
    <string name="events_schedule_changed">%1$s ha cambiado el horario</string>
    <!-- %2$s: time -->
    <string name="events_limited_started">%1$s: ha iniciado el horario limitado hasta %2$s</string>
    <string name="events_bedtime_started">%1$s: ha iniciado la hora de dormir hasta %2$s</string>
    <string name="events_manual_mode_ended">%1$s: ha terminado el horario limitado o la hora de dormir iniciados a mano</string>
    <string name="events_limits_changed">%1$s ha cambiado los límites diarios de las aplicaciones</string>
    <!-- The list of apps a parent can give access to (and the child can ask for) -->
    <string name="events_offer_on">%1$s: ha vuelto a mostrar %2$s en la lista de aplicaciones</string>
    <string name="events_offer_off">%1$s: ha ocultado %2$s de la lista de aplicaciones</string>
    <string name="events_calls_changed">%1$s ha cambiado los ajustes de llamadas</string>
    <string name="events_parent_mode_ended">%1$s: ha terminado el modo padres</string>
    <!-- %2$s: time -->
    <string name="events_parent_mode_on">%1$s: modo padres hasta %2$s</string>
    <string name="events_pin_changed">%1$s ha cambiado el PIN parental</string>
    <string name="events_battery_alerts_off">%1$s ha desactivado el aviso de batería baja</string>
    <!-- %2$d: battery percentage -->
    <string name="events_battery_alert_set">%1$s ha puesto el aviso de batería baja al %2$d%%</string>
    <string name="events_debugging_off">%1$s ha desactivado la depuración</string>
    <string name="events_released">%1$s ha liberado este teléfono: PhoneLock ya no lo controla</string>
    <string name="events_release_failed">No se ha podido liberar este teléfono: PhoneLock sigue controlándolo</string>
    <string name="events_released_child">PhoneLock ya no controla este teléfono</string>
    <string name="events_released_child_uninstall">Toca para desinstalar PhoneLock</string>
    <!-- %2$s: contact's name -->
    <string name="events_contact_added">%1$s: ha añadido el contacto %2$s</string>
    <string name="events_contact_removed">%1$s: ha eliminado el contacto %2$s</string>
    <!-- %1$s: contact's name -->
    <string name="events_contact_add_failed">No se pudo añadir el contacto %1$s</string>
    <string name="events_ringing">%1$s está haciendo sonar el dispositivo</string>
    <string name="events_ringing_stopped">%1$s ha detenido el sonido</string>
    <string name="events_screen_viewed">%1$s ha visto la pantalla</string>
    <!-- %2$s: app name -->
    <string name="events_uninstalled">%1$s: ha desinstalado %2$s</string>

    <!-- Audience: parent. A parent's command couldn't be carried out. %1$s: app name. -->
    <string name="events_not_installed">La aplicación %1$s no está instalada</string>
    <string name="events_allowed_while_offline">Se permitió %1$s mientras el dispositivo estaba sin conexión; ese tiempo ya ha pasado</string>
    <string name="events_cant_uninstall">%1$s no se puede desinstalar</string>
    <string name="events_uninstall_failed">No se pudo desinstalar %1$s</string>
    <string name="events_uninstall_needs_device">No se pudo desinstalar %1$s sin preguntar en el dispositivo</string>

    <!-- Audience: parent. Google services screens that lead out of the lock, which parents can allow or block
         as a group. Each names what the screens are for. -->
    <string name="events_area_account">Gestionar tu cuenta de Google</string>
    <string name="events_area_settings">Ajustes de Google</string>
    <string name="events_area_help">Páginas de ayuda de Google</string>
    <string name="events_area_feedback">Enviar comentarios a Google</string>
    <string name="events_area_quickshare">Quick Share (archivos de teléfonos cercanos)</string>
    <!-- Audience: parent. Names one Google services screen, used as %2$s in the screen decisions below.
         %1$s: a technical screen name such as "accountsettings › AccountDetails" (not translated). -->
    <string name="events_screen_named">la pantalla de los servicios de Google %1$s</string>
    <!-- Audience: parent. A parent's decision about a Google services screen or group of screens. %1$s:
         parent's name; %2$s: the group's name (above) or "the Google services screen …"; %3$s: time. -->
    <string name="events_screen_rule_allowed">%1$s ha permitido %2$s</string>
    <string name="events_screen_rule_allowed_until">%1$s ha permitido %2$s hasta %3$s</string>
    <string name="events_screen_rule_blocked">%1$s ha bloqueado %2$s</string>
    <string name="events_screen_rule_reset">%1$s ha devuelto %2$s al valor predeterminado</string>
    <!-- %1$s: the group's name or "the Google services screen …" -->
    <string name="events_screen_rule_no_bedtime">No se pudo permitir %1$s hasta la hora de dormir: no hay ninguna hora de dormir próxima</string>
    <!-- Audience: parent. The lock sent the child back from a Google services screen. %1$s: a group's name
         (above), or a technical screen name (not translated); %2$s: the app it was opened from. -->
    <string name="events_blocked_area">Se ha bloqueado %1$s</string>
    <string name="events_blocked_area_from">Se ha bloqueado %1$s al abrirse desde %2$s</string>
    <string name="events_blocked_screen">Se ha bloqueado una pantalla de los servicios de Google (%1$s)</string>
    <string name="events_blocked_screen_from">Se ha bloqueado una pantalla de los servicios de Google (%1$s) al abrirse desde %2$s</string>

    <!-- Audience: parent. "Parent screen view" (which lets parents see the screen) was switched off. "Fix setup
         over Wi-Fi" is a button in the parents' app: use the same words as that button. -->
    <string name="events_screen_view_restored">La vista de pantalla se desactivó en el dispositivo (desde la revisión de privacidad de Android) y se ha vuelto a activar</string>
    <string name="events_screen_view_off">La vista de pantalla se ha desactivado en el dispositivo. Usa Reparar configuración por Wi-Fi para volver a activarla</string>

    <!-- Audience: parent. Why a screenshot a parent asked for couldn't be taken. "Settings > Accessibility"
         should match Android's own menu names in this language; "Parent screen view" is this app's
         accessibility service as listed there. -->
    <string name="events_shot_no_service">La vista de pantalla no está activada. En el dispositivo, desbloquea el modo padres y activa Ajustes &gt; Accesibilidad &gt; Vista de pantalla para padres</string>
    <string name="events_shot_screen_off">La pantalla está apagada</string>
    <string name="events_shot_failed">No se pudo capturar la pantalla</string>
    <!-- %1$s: app name -->
    <string name="events_shot_secure">%1$s bloquea las capturas de pantalla</string>
    <string name="events_shot_secure_unknown">La aplicación que está en pantalla bloquea las capturas de pantalla</string>
    <string name="events_shot_too_soon">Ha pasado muy poco desde la última captura; vuelve a intentarlo</string>
    <!-- %1$d: Android's error code -->
    <string name="events_shot_error">No se pudo capturar la pantalla (error %1$d)</string>

    <!-- Audience: parent. Why the device couldn't say where it is. -->
    <string name="events_location_off">La ubicación está desactivada en el dispositivo</string>
    <string name="events_location_no_provider">El dispositivo no tiene ningún proveedor de ubicación</string>
    <string name="events_location_no_permission">El dispositivo no tiene permiso de ubicación</string>
    <string name="events_location_no_fix">Aún no se ha obtenido la ubicación</string>

    <!-- Audience: parent. Why a usage report has no data; the parents' app adds advice after it. -->
    <string name="events_usage_not_allowed">El dispositivo no permite leer el uso de aplicaciones</string>

    <!-- Audience: parent. Calls. %1$s: the contact's name or the phone number. -->
    <string name="events_call_attempt">Ha intentado llamar a %1$s (no está en la lista de confianza)</string>
    <string name="events_call_blocked">Se ha bloqueado una llamada de %1$s</string>

    <!-- Audience: parent. A daily app time limit ran out. %1$s: list of the limits' names. -->
    <string name="events_times_up_today">Hoy se acabó el tiempo: %1$s</string>

    <!-- Audience: parent. The schedule moved to another mode. %1$s: time it lasts until. -->
    <string name="events_mode_normal">Horario normal</string>
    <string name="events_mode_normal_until">Horario normal hasta %1$s</string>
    <string name="events_mode_limited_until">Horario limitado hasta %1$s</string>
    <string name="events_mode_bedtime_until">Hora de dormir hasta %1$s</string>

    <!-- Audience: parent. Battery and power. %1$d: battery percentage. -->
    <string name="events_battery_low">Batería baja: %1$d%%</string>
    <string name="events_turning_off">Apagándose</string>
    <string name="events_turning_off_level">Apagándose (batería %1$d%%)</string>
    <string name="events_turning_off_empty">Apagándose: la batería se ha agotado</string>

    <!-- Audience: parent. Changes on the device that cut it off or get around the lock. -->
    <string name="events_airplane_on">Modo avión activado (sin llamadas ni actualizaciones de ubicación hasta que se desactive)</string>
    <string name="events_airplane_off">Modo avión desactivado</string>
    <string name="events_mobile_data_on">Datos móviles activados</string>
    <string name="events_mobile_data_off">Datos móviles desactivados (a partir de ahora, solo Wi-Fi)</string>
    <!-- %1$s: app name -->
    <string name="events_installed">Se ha instalado %1$s</string>
    <string name="events_installed_parent_mode">Se ha instalado %1$s durante el modo padres</string>
    <string name="events_sim_removed">Tarjeta SIM retirada (sin llamadas ni datos móviles)</string>
    <!-- %1$s: the mobile carriers' names -->
    <string name="events_sim_inserted">Tarjeta SIM insertada (%1$s)</string>
    <string name="events_sim_changed">Tarjeta SIM cambiada (ahora %1$s)</string>

    <!-- Audience: parent. An alert that reaches the parents late says when it happened. %1$s: the alert (one of
         the messages above); %2$s: the time it happened. -->
    <string name="events_late">%1$s (a las %2$s)</string>

    <!-- Audience: child and parent. The name of a daily app time limit that has no name of its own and no apps. -->
    <string name="events_limit_apps">Aplicaciones</string>

    <!-- Audience: parent. Stands in for the caller in call events when the number is hidden, e.g.
         "Blocked a call from a private number" -->
    <string name="events_private_number">un número oculto</string>
</resources>
