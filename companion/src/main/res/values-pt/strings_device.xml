<!-- Activity (location history and map), file transfers, the first-run disclosure, Diagnostics, device Settings and this app's own updates. -->
<resources>
    <!-- Activity: page, map and filters -->
    <string name="device_activity_title">Atividade</string>
    <string name="device_close_full_map">Fechar mapa em tela cheia</string>
    <string name="device_show_map">Mostrar mapa</string>
    <string name="device_hide_map">Ocultar mapa</string>
    <!-- Spoken label of the Refresh button while the child's device is being located -->
    <string name="device_locating">Localizando</string>
    <!-- %1$s: a time, e.g. 2:15 p.m. -->
    <string name="device_no_location_at">Nenhuma localização registrada às %1$s</string>
    <string name="device_nothing_this_day">Nada para mostrar neste dia.</string>
    <!-- Filter buttons above the timeline: four must fit across a phone, so keep them short -->
