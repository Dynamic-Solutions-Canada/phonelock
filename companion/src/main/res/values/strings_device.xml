    <string name="device_names_saved">Names saved</string>
    <string name="device_save_names">Save names</string>
    <string name="device_parent_access">Parent access</string>
    <string name="device_parent_mode">Parent mode…</string>
    <string name="device_parent_mode_detail">Unlock Settings and the Play Store on their device for a while</string>
    <string name="device_change_pin">Change parent PIN…</string>
    <string name="device_change_pin_detail">Used on their device by holding the clock for 4 seconds</string>
    <string name="device_lock_app">Lock app</string>
    <!-- %1$d: the lock app's version number -->
    <string name="device_lock_version">Version %1$d</string>
