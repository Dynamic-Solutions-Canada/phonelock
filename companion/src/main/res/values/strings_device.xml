<?xml version="1.0" encoding="utf-8"?>
<!-- Activity (location history and map), file transfers, the first-run disclosure, Diagnostics, device Settings and this app's own updates. -->
<resources>
    <!-- Activity: page, map and filters -->
    <string name="device_activity_title">Activity</string>
    <string name="device_close_full_map">Close full-screen map</string>
    <string name="device_show_map">Show map</string>
    <string name="device_hide_map">Hide map</string>
    <!-- Spoken label of the Refresh button while the child's device is being located -->
    <string name="device_locating">Locating</string>
    <!-- %1$s: a time, e.g. 2:15 p.m. -->
    <string name="device_no_location_at">No location recorded at %1$s</string>
    <string name="device_nothing_this_day">Nothing to show on this day.</string>
    <!-- Filter buttons above the timeline: four must fit across a phone, so keep them short -->
    <string name="device_filter_places">Places</string>
    <string name="device_filter_calls">Calls</string>
    <string name="device_filter_apps">Apps</string>
    <string name="device_filter_events">Events</string>
    <string name="device_today">Today</string>
    <string name="device_yesterday">Yesterday</string>

    <!-- Activity: timeline rows. Detail facts are joined with " · " and the first letter of the line is capitalised automatically, so they start lowercase. -->
    <!-- %1$s: a street address or coordinates -->
    <string name="device_at_place">at %1$s</string>
    <!-- %1$d: accuracy in metres -->
    <string name="device_within_metres">within %1$d m</string>
    <!-- %1$d: battery level in percent -->
    <string name="device_battery">battery %1$d%%</string>
    <string name="device_battery_charging">battery %1$d%% (charging)</string>
    <!-- %1$s: how long ago, e.g. 5 min ago -->
    <string name="device_seen_ago">seen %1$s</string>
    <!-- A stretch of time with no location readings from the child's device -->
    <string name="device_no_readings">No readings</string>
    <!-- A call: %1$s arrow symbol, %2$s direction (e.g. Outgoing), %3$s who -->
    <string name="device_timeline_call">📞 %1$s %2$s: %3$s</string>
    <!-- As above, with %4$s the call's length (e.g. 2:05) -->
    <string name="device_timeline_call_length">📞 %1$s %2$s: %3$s · %4$s</string>
    <!-- App use: %1$s app name, %2$s how long (e.g. 15 min) -->
    <string name="device_timeline_app">📱 %1$s, %2$s</string>
    <!-- The time column of the current location row, and the map marker for it -->
    <string name="device_now">Now</string>
    <!-- The current location: %1$s is an address, an error from the device, or one of the two lines below -->
    <string name="device_timeline_now">📍 Now: %1$s</string>
    <string name="device_now_locating">locating…</string>
    <string name="device_now_no_answer">no answer (offline or switched off)</string>
    <!-- Map pin on a place where the child stayed a while (when its address is unknown) -->
    <string name="device_map_stop">Stop</string>
    <!-- A span of times: %1$s start, %2$s end (e.g. 2:15 p.m. – 5:30 p.m.) -->
    <string name="device_time_range">%1$s – %2$s</string>
    <!-- A short day name and a time, for spans crossing midnight: %1$s day (e.g. Fri), %2$s time -->
    <string name="device_day_time">%1$s %2$s</string>

    <!-- File transfers (shown while browsing the child's files). %1$s is a file name. -->
    <!-- Wraps a status while several files are saved: %1$d this file's number, %2$d how many, %3$s the status -->
    <string name="device_batch_status">(%1$d of %2$d) %3$s</string>
    <!-- %1$d files saved of %2$d -->
    <plurals name="device_batch_saved">
        <item quantity="one">Saved %1$d of %2$d file to Downloads/PhoneLock</item>
        <item quantity="other">Saved %1$d of %2$d files to Downloads/PhoneLock</item>
    </plurals>
    <!-- %1$d files saved of %2$d; %3$d of them failed -->
    <plurals name="device_batch_saved_some_failed">
        <item quantity="one">Saved %1$d of %2$d file to Downloads/PhoneLock; %3$d couldn\'t be downloaded</item>
        <item quantity="other">Saved %1$d of %2$d files to Downloads/PhoneLock; %3$d couldn\'t be downloaded</item>
    </plurals>
    <!-- %1$s: the child's device name, %2$s: a file name -->
    <string name="device_file_asking">Asking %1$s\'s device for %2$s…</string>
    <string name="device_file_no_answer">No answer from %1$s\'s device for %2$s. It may be off or offline.</string>
    <string name="device_file_preparing">Preparing %1$s…</string>
    <string name="device_file_cant_read">Couldn\'t read %1$s</string>
    <string name="device_file_too_large">%1$s is over 48 MB</string>
    <string name="device_file_uploading">Uploading %1$s…</string>
    <string name="device_file_sent">Sent %1$s; waiting for the device to save it…</string>
    <!-- %1$d: an HTTP status code -->
    <string name="device_upload_failed_http">Upload failed (HTTP %1$d)</string>
    <!-- %1$s: the reason, as the system words it -->
    <string name="device_upload_failed">Upload failed: %1$s</string>
    <string name="device_file_uploaded">Uploaded %1$s</string>
    <string name="device_file_downloading">Downloading %1$s…</string>
    <string name="device_file_saved">Saved %1$s to Downloads/PhoneLock</string>
    <string name="device_file_cant_download">Couldn\'t download %1$s</string>
    <string name="device_file_opening">Opening %1$s…</string>
    <string name="device_file_cant_open">Couldn\'t open %1$s</string>
    <string name="device_file_opened">Opened %1$s (not saved)</string>
    <string name="device_file_no_viewer">No app on this phone can open %1$s. Use Save to Downloads instead.</string>

    <!-- First-run disclosure, which the parent must accept before adding a device -->
    <string name="device_disclosure_title">Before you start</string>
    <string name="device_disclosure_intro">PhoneLock is a parental control app. It lets you manage your child\'s phone or tablet and see information from it.</string>
    <string name="device_disclosure_seen_title">What you\'ll see from your child\'s device</string>
    <!-- A bulleted list: keep one item per line -->
    <string name="device_disclosure_seen">• Its location: on request, and a log every 15 minutes (every 2 while moving), kept 7 days\n• Battery level, and when it turns off or on\n• Installed apps, requests to use them, and which apps they use and for how long\n• Wi-Fi networks they join and Bluetooth devices they pair\n• Calls (call log) and contacts\n• Files, photos and videos in its shared storage, when you open them\n• Its screen, when you tap View screen</string>
    <string name="device_disclosure_readers_title">Who can read it</string>
    <string name="device_disclosure_readers">Only you and other parents you share the device with. Everything is end-to-end encrypted on the devices; the relay server that passes messages along, and Google\'s push service, only ever see encrypted data. Nothing is sold or used for ads.</string>
    <string name="device_disclosure_child_title">Your child is told</string>
    <string name="device_disclosure_child">Their home screen says that location, battery, calls and app use are shared with you, they get a notice each time a parent views their screen, and a notification shows that parent controls are active. PhoneLock can\'t be hidden from them.</string>
    <string name="device_disclosure_consent">By continuing, you confirm you are the parent or legal guardian of the child whose device you\'ll manage, or have their permission, and that you\'ll use PhoneLock only for that purpose.</string>
    <!-- Opens the privacy policy, which is in English -->
    <string name="device_privacy_policy">Privacy policy</string>
    <string name="device_disclosure_agree">I agree, continue</string>

    <!-- Diagnostics. %1$s is the child's device name. -->
    <string name="device_diag_title">Diagnostics</string>
    <string name="device_diag_asking">Asking %1$s…</string>
    <string name="device_diag_ask_again">Ask again</string>
    <!-- Subject of the shared report -->
    <string name="device_diag_subject">%1$s diagnostics</string>
    <string name="device_diag_share_title">Share diagnostics</string>
    <string name="device_diag_share">Share</string>
    <string name="device_diag_waiting">Waiting for %1$s to answer. If it\'s offline or off, nothing will come.</string>
    <string name="device_diag_no_report">No report yet.</string>
    <!-- %1$s: when the report was made -->
    <string name="device_diag_report_from">Report from %1$s</string>
    <string name="device_diag_checks">Checks</string>
    <string name="device_diag_recent_log">Recent log</string>
    <string name="device_diag_show_log">Show log</string>
    <string name="device_diag_hide_log">Hide log</string>
    <!-- Shown when the device sent an empty log -->
    <string name="device_diag_log_empty">Empty.</string>
    <!-- First line of the shared report: %1$s device name, %2$s date and time -->
    <string name="device_diag_report_heading">%1$s diagnostics, %2$s</string>
    <!-- Heading above the log in the shared report -->
    <string name="device_diag_report_log">Recent log:</string>

