<?xml version="1.0" encoding="utf-8"?>
<!-- Wording shared across the app. Each screen or feature keeps its own wording in its own
     strings_<area>.xml beside this file; every file here needs the same file, with the same names, in each
     values-<language> folder. Names, app labels and anything typed by a person are never translated. -->
<!-- French (France and Canada), addressing the parent as "vous". Glossary: device = appareil; parent mode = mode parent;
     parent PIN = code PIN parent; limited hours = Heures limitées; bedtime = Heure du coucher; normal hours = Heures normales;
     allow = Autoriser; request = demande; "Ask for an app" (child's button) = "Demander une application". -->
<resources>
    <string name="app_name">Phone Lock</string>

    <!-- Common buttons and labels: use these rather than adding another copy -->
    <string name="cancel">Annuler</string>
    <string name="save">Enregistrer</string>
    <string name="done">Terminé</string>
    <string name="open">Ouvrir</string>
    <string name="remove">Retirer</string>
    <string name="delete">Supprimer</string>
    <string name="refresh">Actualiser</string>
    <string name="try_again">Réessayer</string>
    <string name="back">Retour</string>
    <string name="next">Suivant</string>
    <string name="add">Ajouter</string>
    <string name="allow">Autoriser</string>
    <string name="deny">Refuser</string>
    <string name="undo">Annuler</string>
    <string name="your_name">Votre nom</string>
    <string name="child_device_name">Nom de l’appareil de l’enfant</string>

    <!-- Lengths of time, as fmtMinutes() writes them -->
    <string name="duration_minutes">%1$d min</string>
    <string name="duration_hours">%1$d h</string>
    <string name="duration_hours_minutes">%1$d h %2$d min</string>

    <!-- Settings > Language -->
    <string name="language_title">Langue</string>
    <string name="language_match_device">Langue de l’appareil</string>
    <string name="language_detail">La langue utilisée par cette application sur ce téléphone</string>
</resources>
