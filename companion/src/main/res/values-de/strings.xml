<?xml version="1.0" encoding="utf-8"?>
<!-- Wording shared across the app. Each screen or feature keeps its own wording in its own
     strings_<area>.xml beside this file; every file here needs the same file, with the same names, in each
     values-<language> folder. Names, app labels and anything typed by a person are never translated. -->
<!-- German, addressing the parent as "du". Glossary: device = Gerät; parent = Elternteil; parent mode = Elternmodus;
     parent PIN = Eltern-PIN; limited hours = Begrenzte Zeit; bedtime = Schlafenszeit; normal hours = Normale Zeit;
     allow = erlauben; request = Anfrage; "Ask for an app" (child's button) = „App anfragen“. -->
<resources>
    <string name="app_name">PhoneLock</string>

    <!-- Common buttons and labels: use these rather than adding another copy -->
    <string name="cancel">Abbrechen</string>
    <string name="save">Speichern</string>
    <string name="done">Fertig</string>
    <string name="open">Öffnen</string>
    <string name="remove">Entfernen</string>
    <string name="delete">Löschen</string>
    <string name="refresh">Aktualisieren</string>
    <string name="try_again">Erneut versuchen</string>
    <string name="back">Zurück</string>
    <string name="next">Weiter</string>
    <string name="add">Hinzufügen</string>
    <string name="allow">Erlauben</string>
    <string name="deny">Ablehnen</string>
    <string name="undo">Rückgängig</string>
    <string name="your_name">Dein Name</string>
    <string name="child_device_name">Gerätename des Kindes</string>

    <!-- Lengths of time, as fmtMinutes() writes them -->
    <string name="duration_minutes">%1$d Min.</string>
    <string name="duration_hours">%1$d Std.</string>
    <string name="duration_hours_minutes">%1$d Std. %2$d Min.</string>

    <!-- Settings > Language -->
    <string name="language_title">Sprache</string>
    <string name="language_match_device">Gerät folgen</string>
    <string name="language_detail">Die Sprache dieser App auf diesem Smartphone</string>
</resources>
