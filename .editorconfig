root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{js,mjs,cjs,ts,json,yml,yaml,css,md,html}]
indent_size = 2

[*.{kt,kts}]
# Kotlin coding conventions, matching kotlin.code.style=official in gradle.properties.
ktlint_code_style = intellij_idea
# Compose functions are named like classes.
ktlint_function_naming_ignore_when_annotated_with = Composable
